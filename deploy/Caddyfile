# 공용 서버 입구. JEJARI_DOMAIN 예: 34-64-12-34.sslip.io (외부 IP를 하이픈으로, 도메인 없이 HTTPS)
#
# 왜 HTTPS인가: 리프레시 토큰 쿠키가 Secure라 http에서는 브라우저가 저장·전송하지 않습니다.
# 왜 앞에 두나: 앱 포트(8080·8081)를 인터넷에 열지 않고, 지표(/actuator/prometheus)를 밖에 보이지 않게 합니다.
{$JEJARI_DOMAIN} {
	encode zstd gzip

	# 서버 상태 확인만 밖으로. 나머지 actuator(지표 등)는 내부 전용
	@actuatorPrivate {
		path /actuator/*
		not path /actuator/health /actuator/health/*
	}
	respond @actuatorPrivate 404

	# 보안 헤더. 앱(Spring)은 Caddy 뒤에서 http로 보여 HSTS를 붙이지 않으므로 여기서 붙입니다.
	# CSP는 먼저 Report-Only(차단 없이 브라우저 콘솔에만 위반 표시)로 둡니다. 배포한 화면에서
	# 콘솔에 위반이 없는 것을 확인한 뒤 헤더 이름을 Content-Security-Policy로 바꿔 강제합니다.
	# script-src 'self': 인라인·외부 스크립트 차단(XSS 방어선). style은 React 인라인 스타일 때문에 'unsafe-inline',
	# 글꼴은 index.html의 Google Fonts. 화면에 외부 주소를 추가하면 여기 허용 목록도 함께 고칩니다.
	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# 모니터링 (Grafana 로그인 필요, 팀원은 보기 전용 계정). Grafana가 /grafana 아래에서 직접 응답하므로 경로를 자르지 않음
	@grafana path /grafana /grafana/*
	reverse_proxy @grafana 127.0.0.1:3000

	reverse_proxy 127.0.0.1:8080 127.0.0.1:8081 {
		lb_policy round_robin
		# 한 대가 재시작 중이면 다른 대로 (배포 때 한 대씩 재시작)
		lb_try_duration 10s
		health_uri /actuator/health
		health_interval 5s
		health_timeout 2s
		# Caddy는 클라이언트가 보낸 X-Forwarded-For를 믿지 않고 실제 접속 IP로 다시 씁니다 (위조 방지)
	}

	log {
		output stdout
		format console
	}
}
