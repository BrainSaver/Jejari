{
  "uid": "jejari-overview",
  "title": "제자리 · 앱 개요",
  "description": "k6 부하 테스트 중 병목을 위에서 아래로 좁혀 보는 기본 대시보드 (INF-04·ADM-10). 요청 → 스레드·DB 커넥션 → Redis → Kafka → JVM 순서",
  "tags": ["jejari", "app"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "앱",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(jvm_memory_used_bytes, application)", "refId": "app" },
        "definition": "label_values(jvm_memory_used_bytes, application)",
        "refresh": 1,
        "current": { "text": "jejari", "value": "jejari" },
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "label": "인스턴스",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(jvm_memory_used_bytes{application=\"$application\"}, instance)", "refId": "inst" },
        "definition": "label_values(jvm_memory_used_bytes{application=\"$application\"}, instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "한눈에 보기", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "type": "stat", "title": "초당 요청 (actuator 제외)", "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "응답 시간 p95", "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval])))" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "5xx 비율", "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "(sum(rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval])), 1e-9)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.001 }, { "color": "red", "value": 0.01 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "Heap 사용률", "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(jvm_memory_used_bytes{application=\"$application\", instance=~\"$instance\", area=\"heap\"}) / sum(jvm_memory_max_bytes{application=\"$application\", instance=~\"$instance\", area=\"heap\"} > 0)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "DB 커넥션 사용률", "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(hikaricp_connections_active{application=\"$application\", instance=~\"$instance\"}) / sum(hikaricp_connections_max{application=\"$application\", instance=~\"$instance\"})" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.95 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "Redis 메모리 (한도 대비)", "description": "noeviction이라 100%에 닿으면 쓰기가 오류로 거절됩니다 (concurrency.md §14.5)", "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(redis_memory_used_bytes) / max(redis_memory_max_bytes > 0)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },

    { "type": "row", "title": "HTTP 요청", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "panels": [] },
    {
      "type": "timeseries", "title": "API별 초당 요청", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{method}} {{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "API별 응답 시간 p95", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "{{method}} {{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "상태 코드별 초당 응답", "description": "409(좌석 경합)·429(시도 제한)는 정상적인 거절일 수 있음. 5xx가 늘면 장애", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "전체 응답 시간 (p50·p95·p99)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "type": "row", "title": "스레드 · DB 커넥션 (요청이 어디서 기다리는가)", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "panels": [] },
    {
      "type": "timeseries", "title": "Tomcat 요청 스레드 (사용 중 / 최대)", "description": "사용 중이 최대에 붙으면 요청이 스레드를 기다리는 중", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (tomcat_threads_busy_threads{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "사용 중 {{instance}}" },
        { "refId": "B", "expr": "sum by (instance) (tomcat_threads_config_max_threads{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "최대 {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Oracle 커넥션 풀 (Hikari)", "description": "대기(pending)가 0보다 크면 커넥션이 모자라 요청이 줄 서는 중", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(hikaricp_connections_active{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "사용 중" },
        { "refId": "B", "expr": "sum(hikaricp_connections_idle{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "대기 중(idle)" },
        { "refId": "C", "expr": "sum(hikaricp_connections_pending{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "커넥션 기다리는 요청" },
        { "refId": "D", "expr": "sum(hikaricp_connections_max{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "최대" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "커넥션 얻는 데 걸린 시간 p95", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(hikaricp_connections_acquire_seconds_bucket{application=\"$application\", instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "{{pool}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "커넥션 얻기 실패 (타임아웃)", "description": "0이어야 정상. 늘면 풀 크기·느린 쿼리 확인", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(hikaricp_connections_timeout_total{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "타임아웃" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "type": "row", "title": "Redis (대기열·좌석 선점·매수 한도)", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "panels": [] },
    {
      "type": "timeseries", "title": "명령별 응답 시간 p95 (앱 기준)", "description": "EVALSHA = Lua 스크립트 (좌석 선점·한도·대기열 진입)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, db_operation) (rate(lettuce_seconds_bucket{application=\"$application\", instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "{{db_operation}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "명령별 초당 호출 (앱 기준)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (db_operation) (rate(lettuce_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{db_operation}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "Redis 서버 메모리 (사용 / 한도)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(redis_memory_used_bytes)", "legendFormat": "사용" },
        { "refId": "B", "expr": "max(redis_memory_max_bytes)", "legendFormat": "한도 (maxmemory)" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Redis 서버: 초당 명령 · 연결 수 · 밀려난 키", "description": "밀려난 키(evicted)는 noeviction이라 항상 0이어야 함. 0이 아니면 설정이 바뀐 것", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(redis_commands_processed_total[$__rate_interval]))", "legendFormat": "초당 명령" },
        { "refId": "B", "expr": "max(redis_connected_clients)", "legendFormat": "연결 수" },
        { "refId": "C", "expr": "sum(increase(redis_evicted_keys_total[$__rate_interval]))", "legendFormat": "밀려난 키" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "type": "row", "title": "Kafka · 업무 지표", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 }, "panels": [] },
    {
      "type": "timeseries", "title": "Kafka 발행 (초당 · 평균 시간)", "description": "Outbox 릴레이·행동 로그 발행", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 57 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(spring_kafka_template_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "초당 발행" },
        { "refId": "B", "expr": "sum(rate(spring_kafka_template_seconds_sum{application=\"$application\", instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(spring_kafka_template_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval])), 1e-9)", "legendFormat": "평균 시간(s)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Kafka 소비 (그룹별 초당 처리)", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 57 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (spring_kafka_listener_id) (rate(spring_kafka_listener_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{spring_kafka_listener_id}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "좌석 반환 (사유별, 분당)", "description": "jejari.seat.released (강동균, RSV-03·05·CNL-02)", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 57 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (reason) (rate(jejari_seat_released_total{application=\"$application\", instance=~\"$instance\"}[$__rate_interval])) * 60", "legendFormat": "{{reason}}" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "type": "row", "title": "JVM", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 65 }, "panels": [] },
    {
      "type": "timeseries", "title": "Heap 메모리 (사용 / 최대)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 66 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (jvm_memory_used_bytes{application=\"$application\", instance=~\"$instance\", area=\"heap\"})", "legendFormat": "사용 {{instance}}" },
        { "refId": "B", "expr": "sum by (instance) (jvm_memory_max_bytes{application=\"$application\", instance=~\"$instance\", area=\"heap\"} > 0)", "legendFormat": "최대 {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "GC 멈춤 시간 (초당)", "description": "1초 중 GC로 멈춘 시간. 늘면 응답 시간이 같이 튐", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 66 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (instance, action) (rate(jvm_gc_pause_seconds_sum{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{action}} {{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "CPU 사용률", "description": "process = 앱, system = 머신 전체 (k6를 같은 머신에서 돌리면 함께 오름)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 74 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (instance) (process_cpu_usage{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "앱 {{instance}}" },
        { "refId": "B", "expr": "max by (instance) (system_cpu_usage{application=\"$application\", instance=~\"$instance\"})", "legendFormat": "머신 {{instance}}" }
      ],
