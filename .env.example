# .env로 복사해 값을 채웁니다 (.env는 .gitignore에 있음, 커밋 금지).
# docker compose와 Spring Boot(spring.config.import)가 같은 파일을 읽습니다.
# 비밀번호는 팀 공용 값을 쓰지 말고 각자 정합니다. 빈 값이면 compose가 기동을 거부합니다.

# Oracle (gvenzl/oracle-free, 서비스 FREEPDB1)
ORACLE_PASSWORD=
ORACLE_APP_USER=jejari
ORACLE_APP_PASSWORD=
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1

# MongoDB (비밀번호가 접속 URI에 들어가므로 영문·숫자만)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=jejari
MONGO_APP_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017

# Redis
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

# Kafka
KAFKA_BOOTSTRAP=localhost:9092

# Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
