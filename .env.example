# .env로 복사해 값을 채웁니다 (.env는 .gitignore에 있음, 커밋 금지).
# docker compose와 Spring Boot(spring.config.import)가 같은 파일을 읽습니다.
# 비밀번호는 팀 공용 값을 쓰지 말고 각자 정합니다. 빈 값이면 compose가 기동을 거부합니다.

# Oracle (gvenzl/oracle-free, 서비스 FREEPDB1)
ORACLE_PASSWORD=
ORACLE_APP_USER=jejari
ORACLE_APP_PASSWORD=
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1

# MongoDB (비밀번호가 접속 URI에 들어가므로 영문·숫자만)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=jejari
MONGO_APP_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017

# Redis
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

# Kafka
KAFKA_BOOTSTRAP=localhost:9092

# JWT (HS256). 키 만들기: openssl rand -base64 32   (32바이트 미만이면 앱이 기동하지 않음)
JWT_ACTIVE_KID=k1
JWT_SECRET_K1=
# 로컬 http에서 리프레시 쿠키를 쓰려면 false. 배포(HTTPS)에서는 true
JWT_REFRESH_COOKIE_SECURE=false

# 식별정보 가명처리(HMAC) 키: openssl rand -base64 32  (32바이트 미만이면 거부)
# 프로젝트 기간 동안 바꾸지 마세요. 바꾸면 이미 저장된 해시(CI·전화번호·카드 등)와 이어지지 않습니다.
# 팀 전체가 같은 값을 써야 같은 사람의 해시가 같아집니다 (공용 비밀값으로 따로 공유).
JEJARI_HMAC_KEY=

# 개인정보 암호화(AES-256-GCM, 휴대폰 번호 등) 키: k1:<openssl rand -base64 32>  (팀 공용 비밀값, HMAC 키와 달라야 함)
# 키를 바꿀 때는 k2를 추가하고 ACTIVE만 k2로 바꿉니다 (k1은 기존 데이터 복호화용으로 남김). 빈 값이면 앱이 뜨지 않습니다.
JEJARI_ENC_KEYS=
JEJARI_ENC_ACTIVE=k1

# 비밀번호 pepper(DB 밖에 두는 비밀값): p1:<openssl rand -base64 32>  (팀 공용 비밀값, 다른 키와 달라야 함)
# DB만 유출돼서는 비밀번호를 대입해 볼 수 없게 합니다. 바꾸면 기존 비밀번호로 로그인할 수 없으니 p2를 추가해 교체합니다.
JEJARI_PEPPER_KEYS=
JEJARI_PEPPER_ACTIVE=p1

# 첫 관리자 계정 (AUTH-05). admin_user가 비어 있을 때 한 번만 SUPERVISOR로 만들어짐. 만든 뒤에는 비밀번호를 지워도 됨
# ID: 영문 소문자·숫자·.-_ 3~50자 / 비밀번호: 회원과 같은 규칙(10~64자, 흔한 비밀번호·ID 포함 금지)
JEJARI_ADMIN_BOOTSTRAP_ID=
JEJARI_ADMIN_BOOTSTRAP_PASSWORD=

# Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# 공공데이터포털 서비스키. 각자 data.go.kr에서 발급 (국토교통부_(TAGO)_열차정보 활용 신청)
#   쓰는 곳: tools/fetch-train-api.js (기준 데이터 시각표·운임) · tools/load-tago-schedule.js (실제 KTX 시간표)
#            deploy/tago-refresh.sh (공용 서버 매일 갱신)
#   요즘 포털은 64자 키 하나만 줘서 이름을 이 하나로 모았습니다. 옛 이름 DATA_GO_KR_KEY_DEC 도 아직 받습니다
DATA_GO_KR_KEY=
